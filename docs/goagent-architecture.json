  "cards": [
    {
      "dot": "cyan",
      "title": "只向内依赖",
      "items": [
        "Agent 只依赖 4 个抽象接口：core.Client / ToolExecutor / LoopHook / EventBus",
        "gochat 具体客户端仅在 llm.go 默认工厂导入，循环骨架不感知 Provider",
        "宿主通过 With* 选项注入实现，不修改循环骨架"
      ]
    },
    {
      "dot": "violet",
      "title": "挂起续跑（对话式 Agent）",
      "items": [
        "工具返回 ErrNeedExternalInput 哨兵错误即挂起循环",
        "EvSuspend 携带 ExternalInputRequest（permission / ask_user）",
        "外部补 role=tool 消息到 History 后再次 Chat() 即恢复"
      ]
    },
    {
      "dot": "amber",
      "title": "可观测",
      "items": [
        "EventBus 是唯一事件输出通道，覆盖 token 增量到对话生命周期",
        "EvTokenUsage 每轮上报 token 消耗与耗时",
        "默认 InProcessEventBus，可替换为 WebSocket 广播"
      ]
    }
  ]
